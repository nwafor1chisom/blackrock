{
  "version": 2,
  "builds": [
    {
      "src": "blackrock/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "templates/**",
          "static/**",
          "core/**",
          "users/**",
          "wallet/**",
          "ledger/**",
          "transactions/**",
          "kyc/**",
          "dashboard/**",
          "referral/**",
          "adminpanel/**",
          "payments/**",
          "blackrock/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "blackrock/wsgi.py"
    }
  ]
}