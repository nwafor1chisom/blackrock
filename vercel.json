{
  "version": 2,
  "builds": [
    {
      "src": "blackrock/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "**/*.py",
          "**/*.html",
          "**/*.css",
          "**/*.js",
          "**/*.txt"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "blackrock/wsgi.py"
    }
  ]
}